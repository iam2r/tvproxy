<?xml version="1.0" encoding="utf-8"?>
<!-- 开启代理按钮三态: 绿 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape><solid android:color="#1B5E20" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#66BB6A" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#1B5E20" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#2E7D32" /><corners android:radius="6dp" /></shape>
    </item>
</selector>