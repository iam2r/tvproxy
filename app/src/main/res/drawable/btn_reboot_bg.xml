<?xml version="1.0" encoding="utf-8"?>
<!-- 重启按钮三态: 灰蓝 -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:state_pressed="true">
        <shape><solid android:color="#263238" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_focused="true">
        <shape><solid android:color="#78909C" /><corners android:radius="6dp" /></shape>
    </item>
    <item android:state_pressed="true">
        <shape><solid android:color="#263238" /><corners android:radius="6dp" /></shape>
    </item>
    <item>
        <shape><solid android:color="#455A64" /><corners android:radius="6dp" /></shape>
    </item>
</selector>